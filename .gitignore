# =============================================
# NODE / FRONTEND
# =============================================
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/.env.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp
.pnp.js

# =============================================
# PYTHON / BACKEND
# =============================================
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
.Python
backend/.venv/
.venv/
venv/
env/
ENV/
*.egg-info/
dist/
build/
*.egg
*.whl
.eggs/

# =============================================
# DATABASE (SQLite — do not commit DB)
# =============================================
backend/*.db
backend/*.db-shm
backend/*.db-wal
*.sqlite
*.sqlite3

# =============================================
# STORAGE (uploads, reports, extracted files)
# =============================================
storage/uploads/
storage/extracted/
storage/reports/

# =============================================
# ENVIRONMENT / SECRETS
# =============================================
.env
.env.*
!.env.example
backend/.env
frontend/.env.local
*.pem
*.key
secrets/

# =============================================
# MODEL CACHE (Hugging Face, sentence-transformers)
# =============================================
.cache/
~/.cache/
backend/.cache/

# =============================================
# IDE & EDITOR
# =============================================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# =============================================
# LOGS
# =============================================
*.log
logs/
*.log.*

# =============================================
# TESTING
# =============================================
.coverage
htmlcov/
.pytest_cache/
coverage.xml
*.cover

# =============================================
# MISC
# =============================================
*.bak
*.tmp
*.orig
